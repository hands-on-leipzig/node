# Keycloak (see README)
# VITE_KEYCLOAK_URL=
# VITE_KEYCLOAK_REALM=
# VITE_KEYCLOAK_CLIENT_ID=

# DRAHT API: prefix only — the client appends /handson/node and /handson (see src/services/draht.js).
# Production example:
#   VITE_DRAHT_API_URL=https://dolibarr.example.com/custom
# Local + DDEV (Vite dev server): use relative /custom and proxy to your DDEV URL (see vite.config.js).
#   VITE_DRAHT_API_URL=/custom
#   VITE_DDEV_PROXY_TARGET=https://<ddev-project>.ddev.site
# Then API calls go to http://localhost:5173/custom/... and Vite forwards /custom to DDEV (no CORS on Dolibarr needed).
# VITE_DRAHT_API_URL=
# VITE_DDEV_PROXY_TARGET=

# GitHub PRs for translations are created by DRAHT (Dolibarr: HANDSON_GITHUB_TOKEN, HANDSON_GITHUB_REPO).
# No separate env vars needed in this frontend.

# Dev / test / staging builds only: show “Dummy-Daten eintragen” on forms (never set on production).
# Enabled automatically in `vite` dev and when building with --mode test|staging|dev|development.
# For a production-mode bundle on a dev host, set explicitly:
# VITE_ENABLE_DEV_DUMMY_FORM_FILL=true
# Force off (e.g. prod-like local build):
# VITE_ENABLE_DEV_DUMMY_FORM_FILL=false
