# VITE_KEYCLOAK_URL=
# VITE_KEYCLOAK_REALM=
# VITE_KEYCLOAK_CLIENT_ID=

# DRAHT API base (path includes custom/handson; client calls …/handson/node/…)
# VITE_DRAHT_API_URL=https://your-dolibarr.example.com/custom/handson/api_proxy.php

# GitHub PRs for translations are created by DRAHT (Dolibarr: HANDSON_GITHUB_TOKEN, HANDSON_GITHUB_REPO).
# No separate env vars needed in this frontend.
